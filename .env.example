# Environment variables the backend reads. Copy to backend/.env and fill in locally.
# An empty value means "use the default".
# Never commit real values: .env files are gitignored, and gitleaks runs in pre-commit and CI.

# Postgres URL. Empty = the `docker compose up db` service on 127.0.0.1:5433.
# Supabase: the Session pooler string (port 5432).
DATABASE_URL=
# Alternative name for DATABASE_URL; set only one of the two.
MKC_DATABASE_URL=

# Git commit of the running build; set by CI/CD.
MKC_COMMIT=

# Seconds the worker waits between polls for work (default 1.0).
MKC_WORKER_POLL_SECONDS=
# File the worker touches on start and every poll; empty = off. The Helm chart sets
# /tmp/mkc-worker-heartbeat, and the worker pod's probe runs mkc-worker-health on it.
MKC_WORKER_HEARTBEAT_FILE=
# mkc-worker-health fails when the heartbeat is older than this (default 30).
MKC_WORKER_HEARTBEAT_MAX_AGE_SECONDS=
# Run lease (MKC-17): how long a claimed run stays leased (default 120) and how often the
# worker renews it (default 20; three renewals must fit into one lease).
MKC_WORKER_LEASE_SECONDS=
MKC_WORKER_LEASE_RENEW_SECONDS=
# Longest wait between database probes during an outage (default 30).
MKC_WORKER_DB_BACKOFF_MAX_SECONDS=
# A database connection attempt fails after this many seconds (default 10).
MKC_DATABASE_CONNECT_TIMEOUT_SECONDS=

# Clerk instance (Frontend API URL), e.g. https://<name>.clerk.accounts.dev. Not a secret.
# Empty = login not configured: /api/me and admin routes answer 503.
# No Clerk secret key is needed: tokens are checked with the instance's public keys.
MKC_CLERK_ISSUER=
# Origins allowed in a token's azp claim, comma-separated. Empty = the local Vite dev server.
MKC_CLERK_AUTHORIZED_PARTIES=
# Browser origins allowed to call the API (CORS), comma-separated. Empty = the local Vite dev server.
MKC_CORS_ORIGINS=
# Extra browser origins as one regex (full match), e.g. Vercel previews; also accepted in the
# token's azp claim. Empty = off.
MKC_CORS_ORIGIN_REGEX=

# Backups (MKC-11). The upload link is a SECRET (an Object Storage pre-authenticated
# request); in production it lives in the Kubernetes Secret mkc-secrets, never here.
MKC_BACKUP_UPLOAD_URL=
# Work directory for the dump before the upload. Empty = /tmp/backup.
MKC_BACKUP_DIR=
# 1 allows a plain http upload link (tests and the Compose smoke stub only).
MKC_BACKUP_ALLOW_HTTP=
# Hours without a good backup before /api/admin/backup-status says stale. Empty = 26.
MKC_BACKUP_STALE_HOURS=

# Models (MKC-13). live | record | replay. Empty = replay: only stored replies, no API key needed,
# nothing spends money. The worker sets live in production.
MKC_MODEL_MODE=
# Role -> provider/model mapping and prices. Empty = the packaged mkc/models/models.yaml.
MKC_MODELS_FILE=
# Directory of recorded model replies; required in record and replay mode.
MKC_MODEL_REPLAY_DIR=
# Model calls one item may make before it fails with step_limit (MKC-15). Empty = 12.
MKC_ITEM_MAX_STEPS=
# Limits and retries (MKC-18, runbook "Limits and retries"). Empty = the default in brackets.
# Run limits: stored turns [300], seconds since the start [7200], EUR [3.00].
MKC_RUN_MAX_STEPS=
MKC_RUN_MAX_WALL_SECONDS=
MKC_RUN_MAX_COST_EUR=
# Failed calls of one tool per item before the item fails [3].
MKC_TOOL_MAX_RETRIES=
# Model call retries on 429/5xx/timeouts [4], first wait [2] doubling up to [60] s, deadline [180] s.
MKC_MODEL_MAX_RETRIES=
MKC_MODEL_BACKOFF_BASE_SECONDS=
MKC_MODEL_BACKOFF_MAX_SECONDS=
MKC_TURN_TIMEOUT_SECONDS=
# Resumes of an item without a new turn before it fails with resume_limit [3].
MKC_ITEM_MAX_RESUMES=
# Tool results larger than this (bytes of JSON) are stored as blob refs (MKC-16). Empty = 16384.
MKC_TURN_INLINE_MAX_BYTES=
# Provider API keys: SECRETS, each with a spending cap at the provider. Local values live only in
# backend/.env (gitignored). OpenRouter is the default route (zero data retention); the Gemini free
# tier may train on inputs, so it gets public PDFs and synthetic sites only.
MKC_OPENROUTER_API_KEY=
MKC_GOOGLE_API_KEY=
MKC_ANTHROPIC_API_KEY=
MKC_META_API_KEY=

# Tracing (MKC-19, runbook "Tracing"). Empty keys = no Langfuse; run_log still records every
# model call, tool call, stop and outage. The secret key is a SECRET (backend/.env, mkc-secrets).
MKC_LANGFUSE_PUBLIC_KEY=
MKC_LANGFUSE_SECRET_KEY=
# The project's region host. Empty = https://cloud.langfuse.com.
MKC_LANGFUSE_BASE_URL=
# Trace environment [development]; production on the VM.
MKC_LANGFUSE_ENVIRONMENT=
# Timeout of one export to Langfuse in seconds [5]; bounds the flush after each run.
MKC_LANGFUSE_TIMEOUT_SECONDS=

# Tests only: 1 skips the database tests on purpose.
MKC_SKIP_DB_TESTS=
