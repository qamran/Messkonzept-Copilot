# Environment variables the backend reads. Copy to backend/.env and fill in locally.
# An empty value means "use the default".
# Never commit real values: .env files are gitignored, and gitleaks runs in pre-commit and CI.

# Postgres URL. Empty = the `docker compose up db` service on 127.0.0.1:5433.
# Supabase: the Session pooler string (port 5432).
DATABASE_URL=
# Alternative name for DATABASE_URL; set only one of the two.
MKC_DATABASE_URL=

# Git commit of the running build; set by CI/CD.
MKC_COMMIT=

# Seconds the worker waits between polls for work (default 1.0).
MKC_WORKER_POLL_SECONDS=

# Clerk instance (Frontend API URL), e.g. https://<name>.clerk.accounts.dev. Not a secret.
# Empty = login not configured: /api/me and admin routes answer 503.
# No Clerk secret key is needed: tokens are checked with the instance's public keys.
MKC_CLERK_ISSUER=
# Origins allowed in a token's azp claim, comma-separated. Empty = the local Vite dev server.
MKC_CLERK_AUTHORIZED_PARTIES=
# Browser origins allowed to call the API (CORS), comma-separated. Empty = the local Vite dev server.
MKC_CORS_ORIGINS=

# Tests only: 1 skips the database tests on purpose.
MKC_SKIP_DB_TESTS=
