# Environment variables the backend reads. Copy to backend/.env and fill in locally.
# Never commit real values: .env files are gitignored, and gitleaks runs in pre-commit and CI.

# Postgres URL. Empty = the `docker compose up db` service on 127.0.0.1:5433.
# Supabase: the Session pooler string (port 5432).
DATABASE_URL=

# Git commit of the running build; set by CI/CD.
MKC_COMMIT=

# Seconds the worker waits between polls for work (default 1.0).
MKC_WORKER_POLL_SECONDS=

# Tests only: 1 skips the database tests on purpose.
MKC_SKIP_DB_TESTS=
